#version 450
// AMD FidelityFX Super Resolution 1, EASU (edge-adaptive upscaling): the game's final image (src, sampled) to an
// image of the window's size (dst). third_party/fsr1 (MIT). Constants from FsrEasuCon (nvn_fsr.cpp).
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 64) in;
layout(push_constant) uniform Push {
    uvec4 con0, con1, con2, con3;
} pc;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_EASU_F 1
AF4 FsrEasuRF(AF2 p) { return textureGather(src, p, 0); }
AF4 FsrEasuGF(AF2 p) { return textureGather(src, p, 1); }
AF4 FsrEasuBF(AF2 p) { return textureGather(src, p, 2); }
#include "ffx_fsr1.h"

void fsr_pixel(AU2 pos) {
    AF3 c;
    FsrEasuF(c, pos, pc.con0, pc.con1, pc.con2, pc.con3);
    imageStore(dst, ASU2(pos), AF4(c, 1.0));
}

void main() {
    // 64 threads cover a 16x16 tile, 4 pixels each (the FSR sample's layout).
    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + AU2(gl_WorkGroupID.x << 4u, gl_WorkGroupID.y << 4u);
    fsr_pixel(gxy);
    gxy.x += 8u;
    fsr_pixel(gxy);
    gxy.y += 8u;
    fsr_pixel(gxy);
    gxy.x -= 8u;
    fsr_pixel(gxy);
}
